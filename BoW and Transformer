# 8 Задание, Transformer с позиционным кодированием
class PositionalEmbedding(layers.Layer):
	def __init__(self, sequence_length, input_dim, output_dim, **kwargs):
		super().__init__(**kwargs)
	#подготовим один слой Embedding для обработки индексов токенов
		self.token_embeddings = layers.Embedding(
		input_dim=input_dim, output_dim=output_dim)
	#второй слой Embedding - для обработки позиций токенов
		self.position_embeddings = layers.Embedding(
		input_dim=sequence_length, output_dim=output_dim)
		self.sequence_length = sequence_length
		self.input_dim = input_dim
		self.output_dim = output_dim
	def call(self, inputs):
		length = tf.shape(inputs)[-1]
		positions = tf.range(start=0, limit=length, delta=1)
		embedded_tokens = self.token_embeddings(inputs)
		embedded_positions = self.position_embeddings(positions)
		#затем два вектора представлений объединяются:
		return embedded_tokens + embedded_positions
		#Так же, как слой Embedding, этот слой должен уметь генерировать маску, 			чтобы дать возможность игнорировать дополнение входных данных нулями. 		Фреймворк автоматически вызывает метод calculate_mask, и полученная 				маска будет передана следующему слою:
	def compute_mask(self, inputs, mask=None):
		return inputs != 0
	#Cоздадим серийность, чтобы получить возможность сохранить модель:
	def get_config(self):
		config = super().get_config()
		config.update({
			"output_dim": self.output_dim,
			"sequence_length": self.sequence_length,
			"input_dim": self.input_dim,
		})
		return config

